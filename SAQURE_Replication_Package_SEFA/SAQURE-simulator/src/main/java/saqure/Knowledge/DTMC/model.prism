dtmc

// availabilities
const double w_a = 0.5;
const double old_a_delivery = 0.683333333;
const double old_a_payment = 0.766666667;
const double old_a_restaurant = 0.766666667;
const double old_a_ordering = 0.8;
const double a_delivery = 0.683333333;
const double a_payment = 0.8;
const double a_restaurant = 0.766666667;
const double a_ordering = 0.8;
const double denom = (a_payment * a_delivery * a_delivery) - (2 * a_payment * a_delivery) - a_delivery + 3;

// response times
const double w_rt = 0.5;
const double old_rt_delivery = 0.655102041;
const double old_rt_payment = 0.818367347;
const double old_rt_restaurant = 0.165306122;
const double old_rt_ordering = 0.655102041;
const double rt_delivery = 0.655102041;
const double rt_payment = 0.9;
const double rt_restaurant = 0.165306122;
const double rt_ordering = 0.655102041;

// vulnerabilities
const double w_v = 0.0;
const double old_v_delivery = 0.436134454;
const double old_v_payment = 0.460784314;
const double old_v_restaurant = 0.281512605;
const double old_v_ordering = 0.498879552;
const double v_delivery = 0.436134454;
const double v_payment = 0.9;
const double v_restaurant = 0.281512605;
const double v_ordering = 0.498879552;

rewards
s=1 : (w_a * (1 - a_ordering) + w_rt * rt_ordering + w_v * v_ordering) / (w_a * (1 - old_a_ordering) + w_rt * old_rt_ordering + w_v * old_v_ordering);
s=2 : (w_a * (1 - a_delivery) + w_rt * rt_delivery + w_v * v_delivery) / (w_a * (1 - old_a_delivery) + w_rt * old_rt_delivery + w_v * old_v_delivery) * (w_a * (1 - a_payment) + w_rt * rt_payment + w_v * v_payment) / (w_a * (1 - old_a_payment) + w_rt * old_rt_payment + w_v * old_v_payment);
s=3 : (w_a * (1 - a_delivery) + w_rt * rt_delivery + w_v * v_delivery) / (w_a * (1 - old_a_delivery) + w_rt * old_rt_delivery + w_v * old_v_delivery);
s=4 : (w_a * (1 - a_restaurant) + w_rt * rt_restaurant + w_v * v_restaurant) / (w_a * (1 - old_a_restaurant) + w_rt * old_rt_restaurant + w_v * old_v_restaurant);

endrewards

