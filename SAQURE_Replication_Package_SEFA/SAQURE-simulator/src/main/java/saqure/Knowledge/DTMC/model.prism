dtmc

// SEFA scale: 1x -> 4 core structural states x 1 replicas = 4 core structural states
// plus START (s=0), success (s=5) and failure (s=6) => 7 reachable states

// availabilities
const double w_a = 0.3;
const double old_a_delivery = 0.6333333333333335;
const double old_a_payment = 0.3666666666666665;
const double old_a_restaurant = 0.1;
const double old_a_ordering = 0.9;
const double a_delivery = 0.6333333333333335;
const double a_payment = 0.3666666666666665;
const double a_restaurant = 0.1;
const double a_ordering = 0.9;
const double p_delivery = 0.6333333333333335;
const double p_payment = 0.3666666666666665;
const double p_restaurant = 0.1;
const double p_ordering = 0.9;
const double denom = (p_payment * p_delivery * p_delivery) - (2 * p_payment * p_delivery) - p_delivery + 3;

// response times
const double w_rt = 0.3;
const double old_rt_delivery = 0.1;
const double old_rt_payment = 0.7153846153846154;
const double old_rt_restaurant = 0.9;
const double old_rt_ordering = 0.5923076923076924;
const double rt_delivery = 0.1;
const double rt_payment = 0.7153846153846154;
const double rt_restaurant = 0.9;
const double rt_ordering = 0.5923076923076924;

// vulnerabilities
const double w_v = 0.4;
const double old_v_delivery = 0.5;
const double old_v_payment = 0.5;
const double old_v_restaurant = 0.5;
const double old_v_ordering = 0.5;
const double v_delivery = 0.5;
const double v_payment = 0.5;
const double v_restaurant = 0.5;
const double v_ordering = 0.5;

rewards "cost"
s=1 : (w_a * (1 - a_ordering) + w_rt * rt_ordering + w_v * v_ordering) / (w_a * (1 - old_a_ordering) + w_rt * old_rt_ordering + w_v * old_v_ordering);
s=2 : (w_a * (1 - a_delivery) + w_rt * rt_delivery + w_v * v_delivery) / (w_a * (1 - old_a_delivery) + w_rt * old_rt_delivery + w_v * old_v_delivery) * (w_a * (1 - a_payment) + w_rt * rt_payment + w_v * v_payment) / (w_a * (1 - old_a_payment) + w_rt * old_rt_payment + w_v * old_v_payment);
s=3 : (w_a * (1 - a_delivery) + w_rt * rt_delivery + w_v * v_delivery) / (w_a * (1 - old_a_delivery) + w_rt * old_rt_delivery + w_v * old_v_delivery);
s=4 : (w_a * (1 - a_restaurant) + w_rt * rt_restaurant + w_v * v_restaurant) / (w_a * (1 - old_a_restaurant) + w_rt * old_rt_restaurant + w_v * old_v_restaurant);

endrewards

rewards "visits"
s>=1 & s<=4 : 1;
endrewards

module sefa
	s : [0..7] init 0;

	[] s=0 -> 1 : (s'=1);
	[] s=1 -> (p_ordering / denom) : (s'=2) + (p_ordering * (1 - p_payment * p_delivery) / denom) : (s'=3) + (p_ordering * (1 - p_payment * p_delivery) * (1 - p_delivery) / denom) : (s'=4) + (1 - p_ordering) : (s'=6);
	[] s=2 -> p_payment * p_delivery : (s'=4) + (1 - p_payment * p_delivery) : (s'=1);
	[] s=3 -> p_delivery : (s'=4) + (1 - p_delivery) : (s'=1);
	[] s=4 -> p_restaurant : (s'=5) + (1 - p_restaurant) : (s'=6);
	[] s=5 -> 1 : (s'=5);
	[] s=6 -> 1 : (s'=0);
endmodule

