dtmc

// SEFA scale: 500x -> 4 core structural states x 500 replicas = 2000 core structural states
// plus START (s=0), success (s=2001) and failure (s=2002) => 2003 reachable states

// availabilities
const double w_a = 0.3;
const double old_a_delivery = 0.9;
const double old_a_payment = 0.9;
const double old_a_restaurant = 0.999;
const double old_a_ordering = 0.999;
const double a_delivery = 0.9;
const double a_payment = 0.9;
const double a_restaurant = 0.9994999999999999;
const double a_ordering = 0.999;
const double p_delivery = 0.9;
const double p_payment = 0.9;
const double p_restaurant = 0.9994999999999999;
const double p_ordering = 0.999;
const double denom = (p_payment * p_delivery * p_delivery) - (2 * p_payment * p_delivery) - p_delivery + 3;

// response times
const double w_rt = 0.3;
const double old_rt_delivery = 0.5;
const double old_rt_payment = 0.5;
const double old_rt_restaurant = 0.5;
const double old_rt_ordering = 0.5;
const double rt_delivery = 0.5;
const double rt_payment = 0.5;
const double rt_restaurant = 0.5;
const double rt_ordering = 0.5;

// vulnerabilities
const double w_v = 0.4;
const double old_v_delivery = 0.3152461475521616;
const double old_v_payment = 0.3152461475521616;
const double old_v_restaurant = 0.3152461475521616;
const double old_v_ordering = 0.3152461475521616;
const double v_delivery = 0.3152461475521616;
const double v_payment = 0.3152461475521616;
const double v_restaurant = 0.9;
const double v_ordering = 0.3152461475521616;

rewards "cost"
s=1 : (w_a * (1 - a_ordering) + w_rt * rt_ordering + w_v * v_ordering) / (w_a * (1 - old_a_ordering) + w_rt * old_rt_ordering + w_v * old_v_ordering);
