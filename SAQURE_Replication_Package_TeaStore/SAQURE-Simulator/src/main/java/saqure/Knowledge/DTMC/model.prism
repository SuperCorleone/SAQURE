dtmc

// availabilities
const double w_a = 0.3;
const double old_a_recommender = 0.633333333;
const double old_a_image = 0.366666667;
const double old_a_authentication = 0.9;
const double old_a_persistence = 0.9;
const double old_a_webui = 0.633333333;
const double a_recommender = 0.633333333;
const double a_image = 0.366666667;
const double a_authentication = 0.9;
const double a_persistence = 0.9;
const double a_webui = 0.633333333;
const double p_recommender = 0.9;
const double p_image = 0.85;
const double p_authentication = 0.95;
const double p_persistence = 0.95;
const double p_webui = 0.9;

// response times
const double w_rt = 0.3;
const double old_rt_recommender = 0.335294118;
const double old_rt_image = 0.429411765;
const double old_rt_authentication = 0.1;
const double old_rt_persistence = 0.335294118;
const double old_rt_webui = 0.194117647;
const double rt_recommender = 0.335294118;
const double rt_image = 0.429411765;
const double rt_authentication = 0.1;
const double rt_persistence = 0.335294118;
const double rt_webui = 0.194117647;

// vulnerabilities
const double w_v = 0.4;
const double old_v_recommender = 0.379646018;
const double old_v_image = 0.305309735;
const double old_v_authentication = 0.124778761;
const double old_v_persistence = 0.9;
const double old_v_webui = 0.117699115;
const double v_recommender = 0.379646018;
const double v_image = 0.305309735;

const double v_authentication = 0.124778761;
const double v_persistence = 0.1;
const double v_webui = 0.117699115;

rewards "cost"
s=1 : (w_a * (1 - a_webui) + w_rt * rt_webui + w_v * v_webui) / (w_a * (1 - old_a_webui) + w_rt * old_rt_webui + w_v * old_v_webui);
s=2 : (w_a * (1 - a_authentication) + w_rt * rt_authentication + w_v * v_authentication) / (w_a * (1 - old_a_authentication) + w_rt * old_rt_authentication + w_v * old_v_authentication);
s=3 : (w_a * (1 - a_recommender) + w_rt * rt_recommender + w_v * v_recommender) / (w_a * (1 - old_a_recommender) + w_rt * old_rt_recommender + w_v * old_v_recommender) * (w_a * (1 - a_image) + w_rt * rt_image + w_v * v_image) / (w_a * (1 - old_a_image) + w_rt * old_rt_image + w_v * old_v_image);
s=4 : (w_a * (1 - a_persistence) + w_rt * rt_persistence + w_v * v_persistence) / (w_a * (1 - old_a_persistence) + w_rt * old_rt_persistence + w_v * old_v_persistence);

endrewards

rewards "visits"
s>=1 & s<=4 : 1;
endrewards

module teaStore
	s : [0..7] init 0;

	[] s=0 -> 1 : (s'=1);
	[] s=1 -> p_webui : (s'=2) + (1-p_webui) : (s'=6);
	[] s=2 -> p_authentication : (s'=3) + (1-p_authentication) : (s'=1);
	[] s=3 -> (p_recommender * p_image) + (1-p_recommender) * p_image + p_recommender * (1-p_image) : (s'=4) + (1-p_recommender) * (1-p_image) : (s'=1);
	[] s=4 -> p_persistence : (s'=5) + (1-p_persistence) : (s'=6);
	[] s=5 -> 1 : (s'=5);
	[] s=6 -> 1 : (s'=0);
endmodule

